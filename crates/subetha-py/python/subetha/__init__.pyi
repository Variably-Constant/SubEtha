"""Type information for the compiled surface.

Held against the module itself by tests/test_surface.py, so a class added
to one and not the other fails the suite rather than going unnoticed.
"""

from types import TracebackType
from typing import Callable, Self, Sequence

class Lagged(Exception):
    """A subscriber fell behind and what it asked for was overwritten."""

class Contended(Exception):
    """Another live process holds the lease and has not been quiet long."""

class WrongLane(Exception):
    """The key belongs to a different lane and must be written through it."""

def boundary_note() -> str: ...

# The transports this wheel was built with. The Sens-O-Matic link is
# always there; each bridge is present only when its feature was built.
transports: list[str]

# Whether this extension was built against an interpreter with no lock.
free_threaded: bool

# What each optional transport brings, so a caller can tell a wheel
# built without one from a name that never existed.
OPTIONAL_BY_TRANSPORT: dict[str, tuple[str, ...]]

