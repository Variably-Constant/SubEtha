    def fetch_sub(self, value: int = 1, order: str = "seq_cst") -> int: ...
    def fetch_or(self, value: int, order: str = "seq_cst") -> int: ...
    def fetch_and(self, value: int, order: str = "seq_cst") -> int: ...
    def fetch_xor(self, value: int, order: str = "seq_cst") -> int: ...
    def swap(self, value: int, order: str = "seq_cst") -> int: ...
    def compare_exchange(
        self, expected: int, new: int, order: str = "seq_cst"
    ) -> int: ...
    def fetch_add_many(self, count: int, value: int = 1, order: str = "seq_cst") -> int: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> bool: ...

